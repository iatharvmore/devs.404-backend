[Unit]
Description=dev's.404 reel dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/daves404-automation
EnvironmentFile=/home/ubuntu/daves404-automation/.env
ExecStart=/home/ubuntu/daves404-automation/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
