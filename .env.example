# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it's already in .gitignore.

# --- Gemini (script + Hindi TTS-script generation) ---
GEMINI_API_KEY=

# --- Sarvam AI (text-to-speech) ---
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=hi-IN

# --- Cloudinary (temporary public hosting for the rendered video, required by IG API) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Instagram Graph API ---
# ig-user-id: your Instagram professional account's numeric ID (Business/Creator, linked to a FB Page)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_API_VERSION=v21.0

# --- Email notification (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# --- Misc ---
# Local working directory for generated files (script, audio, video)
WORK_DIR=./work
